local trackingStats = {}

local activeTarget = nil
local tracking = false

local startTime = 0
local elapsedSaved = 0

local searchName = ""
local targetUserId = nil

--==================================================
-- صورة اللاعب
--==================================================

local function setPlayerImage(userId)

	local success, image = pcall(function()

		return Players:GetUserThumbnailAsync(
			userId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size100x100
		)

	end)

	if success then
		PlayerImage.Image = image
	else
		PlayerImage.Image = ""
	end
end

--==================================================
-- تحديث العداد
--==================================================

local function updateCounter()

	if targetUserId and trackingStats[targetUserId] then

		local stats = trackingStats[targetUserId]

		CounterLabel.Text =
			"دخول: " ..
			stats.joinCount ..
			" | خروج: " ..
			stats.leaveCount
	end
end

--==================================================
-- البحث
--==================================================

SearchInput:GetPropertyChangedSignal("Text"):Connect(function()

	local text = SearchInput.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")

	if #text < 2 then

		activeTarget = nil
		tracking = false
		startTime = 0
		elapsedSaved = 0

		searchName = ""
		targetUserId = nil

		PlayerImage.Image = ""

		InfoLabel.Text = "انتظار استهداف لاعب..."
		TimeLabel.Text = "الوقت: 000:00:00\nيوم: 0 | أسبوع: 0 | شهر: 0 | سنة: 0"
		CounterLabel.Text = "دخول: 0 | خروج: 0"

		return
	end

	local found = nil

	for _, player in ipairs(Players:GetPlayers()) do

		local username = player.Name:lower()
		local displayName = player.DisplayName:lower()

		if username:sub(1, #text) == text
			or displayName:sub(1, #text) == text then

			found = player
			break
		end
	end

	if found then

		if targetUserId ~= found.UserId then

			targetUserId = found.UserId
			searchName = found.Name

			trackingStats[targetUserId] = {
				joinCount = 0,
				leaveCount = 0
			}

			activeTarget = found
			tracking = true

			elapsedSaved = 0
			startTime = os.clock()

			setPlayerImage(found.UserId)
		end

		InfoLabel.Text =
			"الاسم: " ..
			found.Name ..
			"\nالحالة: موجود"

		updateCounter()

	else

		InfoLabel.Text = "اللاعب غير موجود حالياً"
	end
end)

--==================================================
-- خروج اللاعب
--==================================================

Players.PlayerRemoving:Connect(function(player)

	if targetUserId == player.UserId then

		elapsedSaved = math.floor(os.clock() - startTime)

		local stats = trackingStats[targetUserId]

		if stats then
			stats.leaveCount += 1
		end

		tracking = false
		activeTarget = nil

		InfoLabel.Text =
			"الاسم: " ..
			searchName ..
			"\nالحالة: خرج من السيرفر"

		updateCounter()

		task.spawn(function()
			ShowStatus(
				"تم خضوع لحدث",
				Color3.fromRGB(255, 255, 255),
				4
			)
		end)
	end
end)

--==================================================
-- دخول اللاعب
--==================================================

Players.PlayerAdded:Connect(function(player)

	if targetUserId == player.UserId then

		local stats = trackingStats[targetUserId]

		if stats then
			stats.joinCount += 1
		end

		activeTarget = player

		tracking = true
		startTime = os.clock() - elapsedSaved

		InfoLabel.Text =
			"الاسم: " ..
			player.Name ..
			"\nالحالة: دخل السيرفر"

		updateCounter()

		task.spawn(function()
			ShowStatus(
				"تم دخول مستجد للخضوع",
				Color3.fromRGB(255, 255, 255),
				4
			)
		end)
	end
end)

--==================================================
-- العداد
--==================================================

task.spawn(function()

	while true do

		task.wait(0.2)

		if tracking and targetUserId then

			local elapsed =
				math.floor(os.clock() - startTime)

			local hours =
				math.floor(elapsed / 3600)

			local minutes =
				math.floor((elapsed % 3600) / 60)

			local seconds =
				elapsed % 60

			local days =
				math.floor(elapsed / 86400)

			local weeks =
				math.floor(days / 7)

			local months =
				math.floor(days / 30)

			local years =
				math.floor(days / 365)

			TimeLabel.Text = string.format(
				"الوقت: %03d:%02d:%02d\nيوم: %d | أسبوع: %d | شهر: %d | سنة: %d",
				hours,
				minutes,
				seconds,
				days,
				weeks,
				months,
				years
			)
		end
	end
end)

