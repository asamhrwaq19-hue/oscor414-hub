--==================================================
-- أنميشن البداية
--==================================================

task.spawn(function()

	-- ظهور عمك اوسكار
	TweenService:Create(
		OscarText,
		TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{TextTransparency = 0}
	):Play()

	task.wait(0.4)

	-- ظهور استهداف لحدث
	TweenService:Create(
		StatusText,
		TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{TextTransparency = 0}
	):Play()

	-- تشغيل الأغنية إذا وضعت ID
	if Music.SoundId ~= "" then
		Music:Play()
	end

	-- تبقى الشاشة 4 ثواني
	task.wait(4)

	-- اختفاء تدريجي
	local fade1 = TweenService:Create(
		OscarText,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{TextTransparency = 1}
	)

	local fade2 = TweenService:Create(
		StatusText,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{TextTransparency = 1}
	)

	fade1:Play()
	fade2:Play()

	task.wait(0.4)

	-- الشاشة السوداء نفسها تختفي تدريجياً
	TweenService:Create(
		StatusFrame,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{BackgroundTransparency = 1}
	):Play()

	task.wait(1.3)

	StatusFrame.Visible = false

end)

--==================================================
-- إظهار الحالات
--==================================================

local function ShowStatus(text, color, duration)

	StatusFrame.Visible = true
	StatusFrame.BackgroundTransparency = 0

	OscarText.Text = "عمك اوسكار"
	OscarText.TextTransparency = 0

	StatusText.Text = text
	StatusText.TextColor3 = color
	StatusText.TextTransparency = 0

	task.wait(duration or 4)

	TweenService:Create(
		OscarText,
		TweenInfo.new(1),
		{TextTransparency = 1}
	):Play()

	TweenService:Create(
		StatusText,
		TweenInfo.new(1),
		{TextTransparency = 1}
	):Play()

	task.wait(0.3)

	TweenService:Create(
		StatusFrame,
		TweenInfo.new(1),
		{BackgroundTransparency = 1}
	):Play()

	task.wait(1)

	StatusFrame.Visible = false
end

